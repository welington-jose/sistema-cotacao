# Copie para .env (produção: configure na hospedagem). Nunca suba o .env para o Git.

# Banco (Postgres na Neon)
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Login
NEXTAUTH_URL="https://seu-dominio.com.br"
NEXTAUTH_SECRET="gere com: openssl rand -base64 32"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# E-mail (Brevo) — sem a chave, os e-mails aparecem só no terminal
BREVO_API_KEY=""
EMAIL_REMETENTE="nao-responda@seu-dominio.com.br"   # precisa estar validado na Brevo
EMAIL_REMETENTE_NOME="Cotações Inteligentes"
EMAIL_SUPORTE="contato@foursistemas.com"

# Pagamento (Asaas)
ASAAS_API_KEY=""
ASAAS_AMBIENTE="sandbox"          # "producao" quando for vender de verdade
ASAAS_WEBHOOK_TOKEN=""            # o mesmo token cadastrado no webhook do Asaas

# Preços e teste (opcional; padrão 49,90 / 478,80 / 7 dias)
PRECO_MENSAL="49.90"
PRECO_ANUAL="478.80"
DIAS_TESTE="7"
